# ─────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Base de datos (MariaDB / MySQL)
# ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lfdm_user
DB_PASS=your_database_password_here
DB_NAME=lfdm_ecommerce

# ─────────────────────────────────────────────
# EcartPay
# ─────────────────────────────────────────────
ECARTPAY_SECRET_KEY=your_ecartpay_secret_key_here
ECARTPAY_API_URL=https://sandbox.ecartpay.com/api

# ─────────────────────────────────────────────
# CORS – dominio(s) del frontend
# ─────────────────────────────────────────────
FRONTEND_ORIGIN=https://tu-usuario.github.io

# ─────────────────────────────────────────────
# Envío (V1 – tarifa plana)
# ─────────────────────────────────────────────
SHIPPING_FLAT_RATE=120
SHIPPING_FREE_THRESHOLD=999
