# ─────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Base de datos (MariaDB / MySQL)
# ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lfdm_user
DB_PASS=your_database_password_here
DB_NAME=lfdm_ecommerce

# ─────────────────────────────────────────────
# EcartPay
#  - Llaves en: panel EcartPay → Integraciones → API
#  - Webhook secret en: panel de administración → Webhooks
#  - Producción: ECARTPAY_API_URL=https://ecartpay.com/api
# ─────────────────────────────────────────────
ECARTPAY_PUBLIC_KEY=your_ecartpay_public_key_here
ECARTPAY_PRIVATE_KEY=your_ecartpay_private_key_here
ECARTPAY_WEBHOOK_SECRET=your_ecartpay_webhook_secret_here
ECARTPAY_API_URL=https://sandbox.ecartpay.com/api

# URL pública de este backend (para el notify_url de los webhooks)
BACKEND_PUBLIC_URL=https://bj-api.site

# ─────────────────────────────────────────────
# CORS – dominio(s) del frontend
# ─────────────────────────────────────────────
FRONTEND_ORIGIN=https://tu-usuario.github.io

# ─────────────────────────────────────────────
# Envío (V1 – tarifa plana)
# ─────────────────────────────────────────────
SHIPPING_FLAT_RATE=120
SHIPPING_FREE_THRESHOLD=999
